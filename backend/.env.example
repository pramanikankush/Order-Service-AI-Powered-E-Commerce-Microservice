# Backend environment variables
# Copy to `.env` and adjust as needed. Docker compose reads these.

# --- Postgres ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/orders
SPRING_DATASOURCE_USERNAME=ankush
SPRING_DATASOURCE_PASSWORD=ankush

# --- Kafka ---
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Ollama (Spring AI) ---
SPRING_AI_OLLAMA_BASE_URL=http://localhost:11434

# --- App ---
# Comma-separated CORS allowlist. Override per environment.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173
